# Allows pnpm/npm to authenticate when cloning this private GitHub repo
# as a git dependency in a host project.
# Set GH_TOKEN in your shell environment or in Vercel environment variables.
//github.com:_authToken=${GH_TOKEN}

# GitHub Packages registry for @stoutalligator scoped packages.
@stoutalligator:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GH_TOKEN}
